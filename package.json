{
  "name": "chrono-evenement",
  "version": "2.4.0",
  "description": "Chronomètre pour événements avec sortie transparente",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win portable --publish never"
  },
  "build": {
    "appId": "com.evenement.chrono",
    "productName": "Chrono Evenement",
    "win": {
      "target": "portable"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "viewer.html",
      "build/*"
    ]
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}